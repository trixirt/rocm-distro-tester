# -----------------------------------------------------------------------------
# .hunspell-whitelist — project-approved technical vocabulary for spell checks
#
# Usage (from repo root; requires: sudo dnf install hunspell hunspell-en-US):
#
# Check any file/prose against en_US, exempting this whitelist:
#
#   tr -cs 'A-Za-z' '\n' < <file> | sort -u | grep -E '^[A-Za-z]{4,}$' \
#   | hunspell -d en_US -C - 2>/dev/null | grep '^&' | awk '{print $2}' | sort -u \
#   | grep -ivFx -f .hunspell-whitelist          #  => empty output means clean
#
# One word per line. Case-variant lines are listed so exact-match greps work.
# -----------------------------------------------------------------------------
