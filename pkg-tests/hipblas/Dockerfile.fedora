# =============================================================================
# ROCm-Tester HIPBLAS Smoke & Unit Test Container (Fedora Rawhide Variant)
# =============================================================================
# Base Image: Fedora Rawhide with full ROCm build/test tools
# Purpose: Run comprehensive HIPBLAS testing - smoke + unit tests on AMD GPU hardware
# This is UPDATED from original to include FULL UNIT TESTS not just smoke tests
# =============================================================================

FROM fedora:rawhide

LABEL maintainer="rocm-tester@example.com"
LABEL description="HIPBLAS smoke+unit test container - Fedora rawhide variant (with full suite)"
LABEL version="0.1.1"  # Updated to include unit tests
LABEL org.opencontainers.image.title="hipblas-smoke-unit-tests-fedora"

# Set environment variables for test configuration
ENV TEST_NAME=hipblas-comprehensive-tests
ENV LOG_LEVEL=info
ENV BUILD_DEPS_VERSIONED=true
ENV HIPBLAS_TEST_TIMEOUT="1800"  # 30 minutes for full suite

# =============================================================================
# BASE TOOL INSTALLATION 
# =============================================================================

RUN dnf update -y && \
    dnf install -y \
        gcc-c++ \
        git \
        cmake \
        ninja-build \
        python3-pip \
        boost-devel \
        rpmbuild \
        rpmdevtools \
        spectool \
        && dnf clean all

# =============================================================================
# ROCm DEPENDENCY INSTALLATION  
# These provide HIPBLAS runtime and development libraries on Fedora system
# =============================================================================

RUN dnf install -y \
    rocm-hip-devel \
    rocminfo \
    rocblas-devel \
    rocsolver-devel \
    hipblas-devel \
    hip-tests \
    && dnf clean all

# =============================================================================
# HIPBLAS UNIT TEST SOURCE CODE SETUP (NEW - includes unit tests)
# Clone Fedora's hipblas RPM source which contains test.cpp
# and compile it to run as part of comprehensive tests
# =============================================================================

RUN git clone --depth 1 https://src.fedoraproject.org/rpms/hipblas.git /opt/hipblas-rpm
WORKDIR /opt/hipblas-rpm

# Get build dependencies from spec file for HIPBLAS
RUN dnf -y builddep --with test hipblas.spec

# Download source tarball
RUN spectool -g -R hipblas.spec

# Copy source to rpmbuild location
RUN mkdir -p ~/rpmbuild/SOURCES && \
    cp hipblas/* ~/rpmbuild/SOURCES

WORKDIR /rocm-packages-tester

# =============================================================================
# COPY COMPREHENSIVE TEST EXECUTION SCRIPT (UPDATED TO INCLUDE UNIT TESTS)
# This script now runs BOTH smoke tests AND full unit tests from test.cpp
# =============================================================================

COPY hipblas-tests/comprehensive-smoketests.sh /opt/smoketests/run_comprehensive_tests.sh
COPY hipblas-tests/hipblas-test-compile.sh /opt/smoketests/compile_and_run_unit_tests.sh

RUN chmod +x /opt/smoketests/*.sh

# =============================================================================
# DEFAULT COMMAND - RUN COMPREHENSIVE TESTS (SMOKE+UNIT) ON GPU
# This performs both:
# 1. Basic ROCm installation verification (smoke tests)  
# 2. Full HIPBLAS unit test suite compilation + execution
# =============================================================================

CMD ["/opt/smoketests/run_comprehensive_tests.sh"]

# Run with: docker run --rm --device=/dev/kfd rocmtester/hipblas-fedora-comprehensive
# This will give you full coverage of both smoke and unit tests!
