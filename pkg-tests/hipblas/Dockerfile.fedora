# =============================================================================
# ROCm-Tester HIPBLAS Smoke Test Container (Fedora Variant)
# =============================================================================
# Base Image: Fedora Rawhide with full ROCm build/test tools
# Purpose: Run HIPBLAS smoke tests on AMD GPU hardware via containerized execution
# =============================================================================

FROM fedora:rawhide

LABEL maintainer="rocm-tester@example.com"
LABEL description="HIPBLAS smoke test container - Fedora rawhide variant"
LABEL version="0.1.0"

# Set environment variables for test configuration
ENV TEST_NAME=hipblas-smoke
ENV LOG_LEVEL=info
ENV BUILD_DEPS_VERSIONED=true

# =============================================================================
# BASE TOOL INSTALLATION 
# =============================================================================

RUN dnf update -y && \
    dnf install -y \
        gcc-c++ \
        git \
        cmake \
        ninja-build \
        python3-pip \
        boost-devel \
        && dnf clean all

# =============================================================================
# ROCm DEPENDENCY INSTALLATION  
# =============================================================================

RUN dnf install -y \
    rocm-hip-devel \
    rocminfo \
    rocblas-devel \
    rocsolver-devel \
    hipblas-devel \
    && dnf clean all

# =============================================================================
# HIPBLAS RPM BUILD & TEST SETUP
# =============================================================================

RUN git clone https://src.fedoraproject.org/rpms/hipblas.git /opt/hipblas-rpm

WORKDIR /opt/hipblas-rpm

# Get build dependencies from spec file
RUN dnf -y builddep --with test hipblas.spec

# Download source tarball and get additional resources  
RUN spectool -g -R hipblas.spec
RUN cp hipblas/* ~/rpmbuild/SOURCES 2>/dev/null || true

# Build with tests enabled
ENV RPMBUILD_OPTS="--with test"

WORKDIR /rocm-packages-tester

# =============================================================================
# COPY SMOKETEST EXECUTION SCRIPT
# =============================================================================

COPY smoke-tests/hipblas-smoke-test.sh /opt/smoketests/run_tests.sh

# Make test script executable
RUN chmod +x /opt/smoketests/run_tests.sh

WORKDIR /rocm-packages-tester

# =============================================================================
# DEFAULT COMMAND - RUN SMOKETESTS ON GPU
# =============================================================================

CMD ["/opt/smoketests/run_tests.sh"]

# Run with: docker run --device=/dev/kfd rocmtester/hipblas-fedora
