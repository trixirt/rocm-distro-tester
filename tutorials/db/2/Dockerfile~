# =============================================================================
# Dockerfile - The Recipe (Tutorial 2)
# Purpose: Defines a simple, tutor-friendly version of the ROCm State Database.
# 
# NOTE FOR THE NOVICE:
# We are using the official "postgres:16" image. This acts as our blank canvas.
# =============================================================================

FROM postgres:16

# --- Configuration Options (The Ingredients) ---
# The following block sets up variables that Postgres reads on its very first boot 
# to generate its internal folders and configuration files automatically.

# Sets the name of the primary database "room" we want to initialize. All tools (like psql or a Python script) 
# must connect to this exact name; otherwise, Postgres won't know where to look for your data.
ENV POSTGRES_DB=rocm_playground

# Automatically creates a user account named 'mydbuser' during that first boot process. 
# In a real production setup (Section 7), we would create a dedicated user strictly for our app ('state-svc') here.
ENV POSTGRES_USER=mydbuser

# Sets the password for the user created above. While we are keeping this here just to maintain the file's internal logic,
# our next step actually bypasses this password requirement entirely.
ENV POSTGRES_PASSWORD=tutorial_secret_password

# The "Security Bypass." Setting this to 'trust' tells Postgres: "If they provide a valid username, let them in 
# without asking for the password defined above." This simplifies the tutorial workflow by removing a complex login step.
ENV POSTGRES_HOST_AUTH_METHOD=trust

# --- The Command (Requested!) ---
# By default, this image starts the database server and then stops because it thinks its job is done. 
# We override CMD here to keep Postgres running in the background while dropping us into a shell.
CMD ["bash"]
